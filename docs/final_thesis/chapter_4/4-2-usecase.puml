@startuml usecase

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam ArrowColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #333333

left to right direction

actor "Manager" as manager
actor "Doctor"  as doctor
actor "Patient" as patient

rectangle "Hospital analytics platform" {
    usecase UC1  as "Authenticate"
    usecase UC2  as "Register a user"
    usecase UC3  as "Manage patient records"
    usecase UC4  as "Manage provider records"
    usecase UC5  as "Record a clinical encounter"
    usecase UC6  as "View own clinical history"
    usecase UC7  as "View home dashboard"
    usecase UC8  as "View statistical dashboards"
    usecase UC9  as "Explore patient clusters"
    usecase UC10 as "Discover sequential patterns"
    usecase UC11 as "Query data in natural language"
}

' Manager: full administrative and analytical access
manager --> UC1
manager --> UC2
manager --> UC3
manager --> UC4
manager --> UC5
manager --> UC7
manager --> UC8
manager --> UC9
manager --> UC10
manager --> UC11

' Doctor: clinical workflow + home dashboard + NL queries
doctor --> UC1
doctor --> UC3
doctor --> UC5
doctor --> UC7
doctor --> UC11

' Patient: personal account scope only
patient --> UC1
patient --> UC6

@enduml
