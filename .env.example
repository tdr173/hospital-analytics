# Postgres credentials. Each service container has its own Postgres database
# (auth-db, clinical-db, ml-db, analytics-db, queue-db); the same user/password
# is reused across them. The per-service POSTGRES_HOST + POSTGRES_DB env are
# set in docker-compose.yml.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme
# Used only for tools running outside docker-compose (e.g. ETL scripts hitting
# the exposed clinical-db). Inside compose, the per-service `POSTGRES_HOST`
# overrides this.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinical

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT — must be identical across all services
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM keys
GEMINI_API_KEY=
GPT_KEY=

# Mail (optional)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
