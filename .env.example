# =============================================================================
# Postgres
# Shared credentials across all five databases (auth, clinical, ml, analytics,
# queue). Inside docker-compose each service overrides POSTGRES_HOST/DB via its
# own environment block; the values here are used by tools running outside
# docker (ETL scripts, local backend, etc.).
# =============================================================================
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinical

# =============================================================================
# RabbitMQ
# Inside docker-compose RABBITMQ_URL is constructed automatically from USER/
# PASSWORD. The HOST/PORT/VHOST vars are used when services connect outside
# docker (e.g. running a service locally against a docker rabbitmq).
# =============================================================================
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# =============================================================================
# Auth / JWT
# SECRET_KEY must be identical across every service. ALGORITHM and
# JWT_EXPIRE_MINUTES are optional (defaults: HS256 / 30 min).
# =============================================================================
SECRET_KEY=
ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# =============================================================================
# ML / LLM
# GPT_KEY — used by clustering LLM summaries and the LangGraph SQL agent (OpenAI).
# Required by analytics and ml-batch services.
# =============================================================================
GPT_KEY=

# =============================================================================
# Mail
# Used by mail-service (SMTP sender) and any service that sends transactional
# mail directly. MAIL_FROM_ADDRESS and MAIL_FROM_NAME appear in the From header.
# =============================================================================
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hospital Analytics
MAIL_USE_TLS=true
MAIL_TIMEOUT=10

# =============================================================================
# Frontend (NEXT_PUBLIC_*)
# These are baked into the client bundle at build time (next build / docker
# build). When running locally with `npm run dev` they are read from
# frontend/.env.local; when building the docker image they are passed as
# build-args in docker-compose.yml. Defaults point at Traefik subdomains.
# =============================================================================
NEXT_PUBLIC_AUTH_URL=http://auth.localhost
NEXT_PUBLIC_USERS_URL=http://users.localhost
NEXT_PUBLIC_CLINICAL_URL=http://clinical.localhost
NEXT_PUBLIC_ANALYTICS_URL=http://analytics.localhost
NEXT_PUBLIC_ML_URL=http://ml.localhost
NEXT_PUBLIC_QUEUE_URL=http://queue.localhost
# Set to true to show Emotion class names in DevTools (dev only)
NEXT_PUBLIC_SHOW_CLASSNAMES=false

# =============================================================================
# Misc
# FRONTEND_URL — used by backend services to build password-reset / email links.
# CORS_ORIGINS  — comma-separated list of allowed origins.
# =============================================================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://app.localhost,http://localhost:3000
