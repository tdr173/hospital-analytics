# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=

# --- LLM keys ---
GEMINI_API_KEY=
GPT_KEY=

# --- JWT auth ---
# Generate with e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Used in account-invite emails to build the set-password link
FRONTEND_URL=http://localhost:3000

# --- RabbitMQ (optional; defaults match docker-compose.yml) ---
# Set RABBITMQ_URL to override the assembled URL below.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# --- Mail sender (SMTP) ---
# Common providers:
#   Gmail:        host=smtp.gmail.com  port=587  use_tls=true   (use an App Password, not your account password)
#   SendGrid:     host=smtp.sendgrid.net  port=587  use_tls=true  user=apikey  password=<API_KEY>
#   Mailgun:      host=smtp.mailgun.org  port=587  use_tls=true
#   AWS SES:      host=email-smtp.<region>.amazonaws.com  port=587  use_tls=true
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Hospital Analytics
# Set to "true" for STARTTLS on port 587, or "ssl" for implicit TLS on port 465. Default: true
MAIL_USE_TLS=true
# Optional: timeout in seconds for SMTP operations
MAIL_TIMEOUT=10
